// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Form {
  id         String  @id @default(uuid())
  userId     String
  published  Boolean @default(false)
  isFavorite Boolean @default(false)

  name        String
  description String @default("")
  content     String @default("[]")
  pages       String @default("[{\"id\":\"page_0\",\"label\":\"Page 1\"}]")

  visits      Int @default(0)
  submissions Int @default(0)

  passwordHash           String?
  thankYouMessage        String?
  redirectUrl            String?
  closeDate              DateTime?
  submissionLimit        Int?
  hasDuplicateProtection Boolean   @default(false)

  accent String        @default("#2563eb")
  logo   String?

  shareURL       String           @unique @default(uuid())
  FormSubmission FormSubmission[]
  inboxes        FormInbox[]

  createdAt DateTime @default(now())
}

model FormSubmission {
  id      String @id @default(uuid())
  formId  String
  form    Form   @relation(fields: [formId], references: [id])
  content String

  createdAt DateTime @default(now())

  inboxes FormInbox[]
}

model Inbox {
  id          String       @id @default(cuid())
  userId      String       @unique
  submissions FormInbox[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model FormInbox {
  id           String         @id @default(cuid())
  inboxId      String
  formId       String
  submissionId String
  answeredAt   DateTime       @default(now())
  form         Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  inbox        Inbox          @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([inboxId, submissionId])
  @@index([formId])
  @@index([submissionId])
}

model FormTemplate {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String   @default("")
  category    String   @default("Custom")
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
